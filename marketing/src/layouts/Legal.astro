---
import Base from "./Base.astro";
import Container from "../components/Container.astro";
import { site } from "../lib/site.js";

const { entry } = Astro.props;
const updated = entry.data.updated.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

/**
 * The "Last updated" line, in the machine-readable form too.
 *
 * Terms and a privacy policy are the pages where a stale copy is a real
 * problem rather than a cosmetic one — for the reader, and for the marketplace
 * and app-store reviews that check them. `dateModified` is what lets a crawler
 * see the page changed; it is also what the sitemap's `lastmod` reads for
 * these two URLs, from the same frontmatter field, so the two cannot disagree.
 */
const jsonLd = ({ ids, canonical }) => ({
  "@type": "WebPage",
  "@id": `${canonical}#legal`,
  name: entry.data.title,
  description: entry.data.description,
  dateModified: entry.data.updated.toISOString(),
  publisher: { "@id": ids.organization },
  mainEntityOfPage: { "@id": ids.webpage },
});
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  jsonLd={jsonLd}
  article={{ modified: entry.data.updated.toISOString() }}
>
  <div class="brand-wash border-b border-line">
    <Container>
      <div class="max-w-3xl py-16 sm:py-20">
        <h1 class="text-4xl sm:text-5xl">{entry.data.title}</h1>
        <p class="mt-4 text-ink-secondary">
          {site.name} · Last updated {updated}
        </p>
      </div>
    </Container>
  </div>
  <Container>
    <article class="prose max-w-3xl py-14 sm:py-16">
      <slot />
    </article>
    <div class="max-w-3xl pb-20">
      <div class="rule-fade"></div>
      <p class="pt-6 text-sm text-ink-secondary">
        Questions about this page: <a class="font-semibold text-blue-ink hover:underline" href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a>
      </p>
    </div>
  </Container>
</Base>
