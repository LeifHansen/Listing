---
import Container from "./Container.astro";
import BrandMark from "./BrandMark.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Button from "./Button.astro";
import { nav, APP_URL } from "../lib/site.js";

const path = Astro.url.pathname.replace(/\/$/, "");
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4">
      <BrandMark />

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
        {nav.map((item) => {
          const active = path === item.href || path.startsWith(item.href + "/");
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class={`rounded-button px-3 py-2 text-sm font-semibold transition-colors ${
                active ? "text-blue-ink" : "text-ink-secondary hover:text-ink"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="flex items-center gap-2">
        <ThemeToggle />
        <Button href={APP_URL} variant="primary" size="sm" class="hidden sm:inline-flex">
          Open the app
        </Button>
        <button
          id="menu-toggle"
          type="button"
          class="grid size-9 place-items-center rounded-[12px] text-ink-secondary hover:bg-bg-sunken hover:text-ink md:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </div>
  </Container>

  <div id="mobile-nav" hidden class="border-t border-line bg-bg md:hidden">
    <Container>
      <nav class="flex flex-col py-3" aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} class="rounded-button px-3 py-2.5 text-sm font-semibold text-ink-secondary hover:bg-bg-sunken hover:text-ink">
            {item.label}
          </a>
        ))}
        <Button href={APP_URL} variant="primary" size="md" class="mt-3 mb-2">Open the app</Button>
      </nav>
    </Container>
  </div>
</header>
<script is:inline>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = panel.hasAttribute("hidden");
    if (open) panel.removeAttribute("hidden");
    else panel.setAttribute("hidden", "");
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
  });
</script>
