---
import Container from "./Container.astro";
import Button from "./Button.astro";
import { APP_URL } from "../lib/site.js";

const {
  title = "Start with the pile you've been avoiding.",
  lede = "Free to use, with 50 AI tokens a month — about ten full listings — that reset on the 1st and cost nothing.",
} = Astro.props;
---
<section class="py-20 sm:py-24">
  <Container>
    <div class="brand-wash relative overflow-hidden rounded-card border border-line bg-card px-6 py-14 text-center shadow-card sm:px-12">
      <img
        src="/brand/thryft-mascot-welcome.webp"
        alt=""
        width="120"
        height="120"
        loading="lazy"
        class="mx-auto mb-6 size-[120px] object-contain"
      />
      <h2 class="mx-auto max-w-2xl text-3xl sm:text-4xl">{title}</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ink-secondary">{lede}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={APP_URL} variant="primary" size="xl">Open the app</Button>
        <Button href="/how-it-works" variant="secondary" size="xl">See how it works</Button>
      </div>
      <p class="mt-5 text-sm text-ink-secondary">No card required · Nothing publishes until you approve it</p>
    </div>
  </Container>
</section>
