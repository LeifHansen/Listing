---
const { class: className = "", size = 36 } = Astro.props;
import { site } from "../lib/site.js";
---
<a href="/" class={`inline-flex items-center gap-2.5 ${className}`} aria-label={`${site.name} home`}>
  <img
    src="/logo-160.webp"
    alt=""
    width={size}
    height={size}
    class="rounded-[10px]"
    style={`width:${size}px;height:${size}px`}
  />
  <span class="font-display text-lg font-semibold tracking-tight text-ink">{site.name}</span>
</a>
