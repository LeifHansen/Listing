---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import { site } from "../../lib/site.js";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date - a.data.date,
);

const fmt = (d) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const description =
  "Notes on selling secondhand, listing at volume, and what we learn building the tool.";

/**
 * The index as a Blog, with its posts as an ordered list.
 *
 * The @id is what every post's `isPartOf` points back at, so the posts and
 * this page describe one publication rather than a set of loose articles that
 * happen to share a path prefix. The ItemList gives a crawler the reading
 * order and the post URLs without having to parse the cards below for them.
 */
const jsonLd = ({ ids, canonical }) => [
  {
    "@type": "Blog",
    "@id": `${canonical}#blog`,
    name: `${site.name} blog`,
    description,
    url: canonical,
    publisher: { "@id": ids.organization },
    inLanguage: "en-US",
    mainEntityOfPage: { "@id": ids.webpage },
    blogPost: posts.map((post) => ({
      "@id": `${new URL(`/blog/${post.id}`, canonical).href}#article`,
    })),
  },
  {
    "@type": "ItemList",
    "@id": `${canonical}#postlist`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: posts.length,
    itemListElement: posts.map((post, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: post.data.title,
      url: new URL(`/blog/${post.id}`, canonical).href,
    })),
  },
];
---
<Base title="Blog" description={description} jsonLd={jsonLd}>
  <div class="brand-wash border-b border-line">
    <Container>
      <div class="max-w-3xl py-16 sm:py-20">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-blue-ink">Blog</p>
        <h1 class="mt-4 text-4xl sm:text-5xl">Notes from the workbench</h1>
        <p class="mt-6 text-lg text-ink-secondary">
          What we learn about listing at volume, and why the product works the
          way it does. <a class="font-semibold text-blue-ink hover:underline" href="/rss.xml">Subscribe by RSS</a>.
        </p>
      </div>
    </Container>
  </div>

  <Container>
    <div class="max-w-3xl py-14 sm:py-16">
      {posts.length === 0 ? (
        <p class="text-ink-secondary">Nothing published yet — check back shortly.</p>
      ) : (
        <ul class="space-y-4">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="block rounded-card border border-line bg-card p-6 shadow-card transition-shadow duration-200 hover:shadow-card-hover"
              >
                <p class="text-sm text-ink-secondary">
                  <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                </p>
                <h2 class="mt-2 text-2xl">{post.data.title}</h2>
                <p class="mt-3 text-ink-secondary">{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <p class="mt-4 flex flex-wrap gap-2">
                    {post.data.tags.map((tag) => (
                      <span class="rounded-full bg-blue-soft px-2.5 py-0.5 font-display text-xs font-semibold text-blue-ink">
                        {tag}
                      </span>
                    ))}
                  </p>
                )}
                <p class="mt-4 text-sm font-semibold text-blue-ink">Read it →</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </Container>
</Base>
