---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import CTA from "../components/CTA.astro";
import {
  site, packs, tokenCosts, perToken, draftsFor,
  FREE_TOKENS_PER_MONTH, APP_URL,
} from "../lib/site.js";

const description =
  "Thryft Shop is free. AI features spend tokens — 50 free every month, then " +
  "packs from $5.99. Purchased tokens never expire.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${site.name} AI tokens`,
  description,
  offers: packs.map((p) => ({
    "@type": "Offer",
    name: p.label,
    price: p.usd.toFixed(2),
    priceCurrency: "USD",
    description: `${p.tokens} AI tokens — about ${draftsFor(p.tokens)} full listing drafts.`,
  })),
};
---
<Base title="Pricing" description={description} jsonLd={jsonLd}>
  <div class="brand-wash border-b border-line">
    <Container>
      <div class="mx-auto max-w-3xl py-16 text-center sm:py-20">
        <p class="font-display text-xs font-semibold uppercase tracking-[0.14em] text-blue-ink">
          Pricing
        </p>
        <h1 class="mt-4 text-4xl sm:text-5xl">The app is free. The AI runs on tokens.</h1>
        <p class="mt-6 text-lg text-ink-secondary">
          No subscription, no seat count, no plan to outgrow. Every account gets
          {FREE_TOKENS_PER_MONTH} tokens a month — roughly {draftsFor(FREE_TOKENS_PER_MONTH)} complete
          listings — and buys more only if it runs out.
        </p>
      </div>
    </Container>
  </div>

  <!-- Free tier -->
  <Container>
    <div class="-mt-6 sm:-mt-8">
      <div class="rounded-card border-2 border-green bg-card p-8 shadow-card-hover sm:p-10">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <div>
            <h2 class="text-2xl">Free, every month</h2>
            <p class="mt-2 max-w-xl text-ink-secondary">
              {FREE_TOKENS_PER_MONTH} AI tokens land in your account on the 1st.
              They don't roll over, so there is nothing to hoard — and nothing to pay.
            </p>
          </div>
          <div class="text-right">
            <p class="font-display text-4xl font-semibold text-green">$0</p>
            <p class="text-sm text-ink-secondary">forever</p>
          </div>
        </div>
        <ul class="mt-6 grid gap-2.5 text-ink-secondary sm:grid-cols-2">
          <li>· Unlimited listings you write yourself</li>
          <li>· All three marketplaces</li>
          <li>· Two-way eBay sync and duplicate detection</li>
          <li>· Web, iOS and Android</li>
        </ul>
        <Button href={APP_URL} variant="primary" size="lg" class="mt-8">Start free</Button>
      </div>
    </div>
  </Container>

  <!-- Packs -->
  <Section
    eyebrow="Top-ups"
    title="Token packs"
    lede="Bought once, yours forever — purchased tokens never expire, and your free allowance is always spent first."
  >
    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {packs.map((pack) => (
        <div
          class={`relative flex flex-col rounded-card border bg-card p-6 shadow-card ${
            pack.popular ? "border-blue ring-1 ring-blue" : "border-line"
          }`}
        >
          {pack.popular && (
            <span class="absolute -top-3 left-6 rounded-full bg-blue px-3 py-1 font-display text-xs font-semibold text-on-accent">
              Most popular
            </span>
          )}
          <h3 class="font-display text-lg font-semibold">{pack.label}</h3>
          <p class="mt-3 font-display text-3xl font-semibold">${pack.usd}</p>
          <p class="mt-1 text-sm text-ink-secondary">${perToken(pack)} per token</p>
          <div class="mt-5 border-t border-line pt-5">
            <p class="font-display text-xl font-semibold text-blue-ink">{pack.tokens} tokens</p>
            <p class="mt-1 text-sm text-ink-secondary">
              about {draftsFor(pack.tokens)} full listing drafts
            </p>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-sm text-ink-secondary">
      Payments handled by Stripe. Card details go to Stripe directly and never reach us.
    </p>
  </Section>

  <!-- What things cost -->
  <Section
    tone="sunken"
    eyebrow="What a token buys"
    title="Every AI feature, priced"
    lede="Charged when you use it, refunded automatically when it fails. You only pay for AI that worked."
  >
    <div class="mt-14 overflow-hidden rounded-card border border-line bg-card shadow-card">
      <table class="w-full text-left">
        <caption class="sr-only">AI feature costs in tokens</caption>
        <thead>
          <tr class="border-b border-line bg-bg-sunken">
            <th scope="col" class="px-6 py-4 font-display text-sm font-semibold">Feature</th>
            <th scope="col" class="px-6 py-4 text-right font-display text-sm font-semibold">Tokens</th>
          </tr>
        </thead>
        <tbody>
          {tokenCosts.map((row) => (
            <tr class="border-b border-line last:border-0">
              <td class="px-6 py-5">
                <p class="font-semibold text-ink">{row.feature}</p>
                <p class="mt-1 text-sm text-ink-secondary">{row.note}</p>
              </td>
              <td class="px-6 py-5 text-right align-top font-display text-2xl font-semibold text-blue-ink">
                {row.tokens}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mx-auto mt-8 max-w-2xl text-center text-ink-secondary">
      Writing and editing listings by hand is always free. Tokens are only spent
      when you ask the AI to do something.
    </p>
  </Section>

  <CTA
    title="Ten listings a month, on the house."
    lede="No card, no trial clock. When you need more, packs start at $5.99."
  />
</Base>
