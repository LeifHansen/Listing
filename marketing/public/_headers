# Security and caching headers for Cloudflare Pages.
#
# The CSP mirrors the posture of the app's own builder (backend/main.py,
# build_csp): default-deny, with only the origins this site genuinely uses.
# Google Fonts is the one third-party dependency — the stylesheet comes from
# fonts.googleapis.com and the font files from fonts.gstatic.com.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://*.hubspot.com https://*.hsforms.com; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://*.hubspot.com https://*.hsforms.com https://cloudflareinsights.com; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed asset filenames change whenever the content does, so they can be
# cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must revalidate so a deploy is visible immediately — the same rule the
# app applies to its own index.html.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
