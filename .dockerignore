.git
.gitignore
.venv
venv
env
# Anywhere in the tree, not just the root: a bare pattern matches only the
# top level, so a hand deploy uploaded (and COPY backend shipped) every
# backend/**/__pycache__ the developer's runs had left behind.
**/__pycache__
**/*.pyc
.ruff_cache
**/.pytest_cache
data
.env
*.local
README.md
run.sh
fly.toml
.dockerignore
.DS_Store
.idea
.vscode

# The marketing site. It has its own build and its own host; the Dockerfile
# never copies it, so shipping it in the app's build context is pure upload
# cost on every deploy — and node_modules/ and dist/ in there would make that
# cost large.
marketing

# Never part of the image. The Dockerfile runs `npm ci` and THEN copies
# frontend/, so a developer's node_modules or a stale dist in the build
# context (a hand `./deploy.sh` uploads the local tree) would overwrite the
# clean install; the native projects are generated on a Mac and huge; the
# tests are run from a checkout, never from the container.
frontend/node_modules
frontend/dist
frontend/ios
frontend/android
backend/tests
