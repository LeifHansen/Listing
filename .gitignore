# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Environment & secrets
.env
*.local

# Runtime data (uploaded images, generated listings, sessions, job status,
# owed refunds, the generated signing key). The whole directory, as
# .dockerignore already has it: listing its subdirectories one by one left
# data/owed-refunds/ -- seller money owed, written by services/owed_refunds.py
# -- one `git add -A` away from a commit. Anchored to the root so a package
# or fixture directory named "data" elsewhere is still tracked.
/data/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/
.claude/

# Frontend build
frontend/node_modules/
# Root-level too: running vitest from the repo root (rather than from
# frontend/) creates node_modules/.vite here, and one of its cache files
# was committed by accident in 2fe10f1.
node_modules/
frontend/dist/

# Capacitor native projects — generated on a Mac by `npx cap add ios/android`
# (see MOBILE.md); never committed.
frontend/ios/
frontend/android/

# Private cutout regression photos. Same manifest format as
# backend/tests/fixtures/cutout, pointed at by CUTOUT_FIXTURES_DIR. Real
# seller photos are not ours to publish, and a regression suite is not a
# reason to try — so the directory is ignored, by name and anywhere it sits.
backend/tests/fixtures/cutout-private/
**/cutout-private/
