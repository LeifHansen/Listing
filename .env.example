# ---------------------------------------------------------------------------
# eBay Listing Generator - configuration
# Copy this file to ".env" and fill in the values you have.
# Everything except ANTHROPIC_API_KEY is optional; the app degrades gracefully.
# ---------------------------------------------------------------------------

# REQUIRED: powers image identification ("lens") and listing content generation.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Postgres (e.g. Neon) for durable listing history + accounts.
# Neon gives a URL like: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Leave blank to run purely off the local filesystem (accounts disabled).
DATABASE_URL=

# Signs login session cookies. Set a long random value in production so
# sessions survive restarts (e.g. `openssl rand -hex 32`).
SECRET_KEY=

# Optional: Cloudflare R2 (or any S3) for durable, publicly-fetchable images.
# Leave blank to serve images off local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=thryft-images
# The bucket's public base URL (its r2.dev URL or a custom domain), no trailing /
R2_PUBLIC_BASE_URL=

# Models used for vision identification and text generation (optional overrides).
VISION_MODEL=claude-opus-4-8
CONTENT_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Photo pipeline engines.
#
# DEFAULT: Photoroom (https://photoroom.com/api). Every "remove background"
# photo gets a Photoroom cutout composited on white with a soft studio shadow
# and enhancement pass.
PHOTOROOM_API_KEY=
# PHOTO_BATCH_WORKERS=4   # photos processed through a remote engine at once

# BACKUP: Adobe Lightroom + Photoshop (Firefly Services). When a Photoroom
# call fails for any reason, the photo is handed to Adobe instead: the
# Lightroom API applies the "studio" develop preset, then the Photoshop
# Remove Background service does the cutout.
#
# Get a server-to-server OAuth credential from a project at
# https://developer.adobe.com/console with the Lightroom and Photoshop APIs
# enabled. BOTH values are required (a single API key is not enough for
# Adobe's server-to-server auth). R2 (above) must ALSO be configured —
# Adobe's async APIs move files via presigned URLs, so R2 is the hand-off
# storage.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Optional: URL to your own exported Lightroom preset (.xmp) to use instead of
# the bundled studio look (backend/assets/studio-preset.xmp).
ADOBE_STUDIO_PRESET_URL=
# Optional overrides (defaults are right for standard Firefly Services access):
# ADOBE_SCOPES=openid,AdobeID,firefly_api,ff_apis
# ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
# ADOBE_IMAGE_API_BASE=https://image.adobe.io

# LAST RESORT (rembg, in-process) — runs ONLY when neither Photoroom nor
# Adobe is configured.
# REMBG_MODEL: "isnet-general-use" (default, best quality) or "u2netp"
#   (smaller/faster/lower-quality) if the host is memory-constrained.
# REMBG_MAX_SIDE: resolution the model runs at (default 640). Lower = faster and
#   lighter on RAM (the mask is upscaled back to full size); raise for crisper
#   cutout edges if the box has headroom.
REMBG_MODEL=isnet-general-use
REMBG_MAX_SIDE=640

# ---------------------------------------------------------------------------
# eBay API (optional). Leave blank to run in "dry-run" mode, where the app
# builds the exact API payloads and saves them to data/exports/ instead of
# calling eBay. Fill these in when you have a developer account to go live.
#
# Create an app + get tokens at https://developer.ebay.com/
# The Inventory API needs a USER access token (OAuth2, scope:
#   https://api.ebay.com/oauth/api_scope/sell.inventory )
# ---------------------------------------------------------------------------

# "sandbox" or "production"
EBAY_ENV=sandbox

# A user OAuth access token (or paste a long-lived one for testing).
EBAY_OAUTH_TOKEN=

# Recommended: "Sign in with eBay" OAuth. Set these three and users can click
# "Connect eBay" in the app - no manual token/policy pasting. CLIENT_ID/SECRET
# come from your eBay app keyset; RUNAME is the redirect URL name whose accepted
# URL points at https://<your-domain>/api/ebay/callback
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# Fallback only (if not using the connect flow): a static refresh token.
EBAY_REFRESH_TOKEN=

# Marketplace Account Deletion notifications - REQUIRED for Production keysets.
# Invent a token (32-80 chars: letters/digits/_/-, e.g. `openssl rand -hex 32`)
# and paste the SAME value here and on developer.ebay.com -> Application Keys ->
# Alerts & Notifications, with the endpoint URL:
#   https://<your-domain>/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Only needed if a proxy rewrites your scheme/host: the exact endpoint URL as
# registered with eBay (used in the challenge hash). Blank = derived from the
# request.
EBAY_DELETION_ENDPOINT=

# Required by eBay offers: your business policy IDs and merchant location.
# Find/create these in Seller Hub or via the Account API.
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
