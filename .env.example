# ---------------------------------------------------------------------------
# Thryft Shop - configuration
# Copy this file to ".env" and fill in the values you have.
# Everything except ANTHROPIC_API_KEY is optional; the app degrades gracefully.
# (GOOGLE_API_KEY is the one worth adding next: it moves item identification
# and pricing onto Gemini with Google Search grounding — see below.)
#
# PRODUCTION NAMES. The Fly app's secrets were typed by hand and some live
# under a different name than the canonical one below; config.py reads both.
# When you look at `fly secrets list` and the name is not here, this is why:
#   EBAY_APP_CLIENT_ID            = EBAY_CLIENT_ID
#   EBAY_CERT_ID                  = EBAY_CLIENT_SECRET
#   ETSY_KEYSTRING                = ETSY_CLIENT_ID
#   NEON_PRODUCTION_DATABASE_URL  = DATABASE_URL
#   STRIPE_API_SECRET_KEY         = STRIPE_SECRET_KEY
#   STRIPE_API_WEBHOOK_SECRET     = STRIPE_WEBHOOK_SECRET
# Non-secret production settings live in fly.toml [env] (EBAY_ENV, PORT,
# OAUTH_ORIGIN, APP_ORIGINS, DATA_DIR=/data, ETSY_ACCESS_TIER, REMBG_*).
#
# Where the app keeps its files: uploaded/optimized photos, exports, job
# status, the generated SECRET_KEY when none is set. A Fly volume in
# production; ./data here.
DATA_DIR=data
# ---------------------------------------------------------------------------

# REQUIRED: powers listing content generation, the refine pass, the item
# specifics fills and the art lookup — and image identification too, unless
# GOOGLE_API_KEY below takes that job over.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# THE ITEM IDENTIFIER. Set this and the photos go to Google's Gemini instead
# of Claude for two passes: identifying the item, and pricing it. The pricing
# one is the reason — with a Google key the lookup runs on Google Search
# GROUNDING, so the model searches for what comparable items actually sold
# for and answers with the pages it read, instead of pricing from memory.
# Get one at https://aistudio.google.com/apikey
#
# The key is the whole switch: set it and identification moves; leave it
# blank and nothing changes. Everything else in the app still runs on Claude.
GOOGLE_API_KEY=

# Optional: Postgres (e.g. Neon) for durable listing history + accounts.
# Neon gives a URL like: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Leave blank to run purely off the local filesystem (accounts disabled).
DATABASE_URL=

# Signs login session cookies. Set a long random value in production so
# sessions survive restarts (e.g. `openssl rand -hex 32`).
SECRET_KEY=

# Encrypts the marketplace refresh tokens stored in the database. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank and a key is derived from SECRET_KEY, so a local or self-hosted
# deployment is protected with no extra setup. Set it explicitly if SECRET_KEY
# might ever be rotated: a token cannot be read back under a different key, and
# those sellers have to reconnect (they see "not connected", never an error).
TOKEN_ENCRYPTION_KEY=

# Optional: Cloudflare R2 (or any S3) for durable images that survive
# restarts. ONLY the three credentials below are needed — create an R2 API
# token (dashboard -> R2 -> Manage API tokens) and copy its Access Key ID +
# Secret Access Key, plus your account id from the R2 overview page.
# Leave all three blank to serve images off local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: bucket name (default "thryft-images", auto-created on first use).
R2_BUCKET=
# Optional: the bucket's public base URL (its r2.dev URL or a custom domain),
# no trailing /. When set, photos are served straight from Cloudflare; when
# blank, the app hands out short-lived presigned URLs instead — no public
# bucket needed.
R2_PUBLIC_BASE_URL=

# Models used for vision identification and text generation (optional overrides).
VISION_MODEL=claude-opus-4-8
CONTENT_MODEL=claude-opus-4-8

# The Gemini model the identifier runs on when GOOGLE_API_KEY is set. The
# default is a rolling alias, not a pinned version: Google retires model ids,
# and a pinned default eventually 404s every draft. If the configured model
# turns out not to exist, the app asks the key what it CAN call, picks the
# newest of the right tier, and logs what it chose — so pinning a specific
# id here is safe, and forgetting to update it is survivable.
# GOOGLE_VISION_MODEL=gemini-pro-latest

# Which backend drafts and prices a listing. "auto" (the default) reads as
# google when GOOGLE_API_KEY is set and anthropic otherwise. Pin it to force
# one — a pin to a backend with no key falls back to the one that has a key
# rather than taking identification down, and /api/health says so.
# IDENTIFY_PROVIDER=auto

# How hard Gemini may think before it answers, when you want to pin it. The
# two model generations spell this differently and the setting takes either:
# a NUMBER is a 2.5-style token budget (0 turns thinking off where the model
# allows it), a WORD is a 3.x-style level (minimal / low / medium / high).
# -1 (the default) says nothing at all, which is the one value that is right
# on every model — each picks its own.
# GOOGLE_THINKING_BUDGET=-1

# Output budgets for the two Google passes. Identify needs headroom: a draft
# that runs past the cap is not a short description, it is unparseable JSON.
# GOOGLE_IDENTIFY_MAX_TOKENS=16384
# GOOGLE_RESEARCH_MAX_TOKENS=8192

# How the post-identify enrichment runs. v2 (default) folds tag reading, item
# specifics, and the maker hunt into ONE vision call (plus a conditional maker
# verify) — the same quality checks in ~2 calls instead of 4-6. v1 restores
# the original multi-call chain if v2 ever misbehaves.
# IDENTIFY_CHAIN=v2

# Whether the item-specifics fill goes BACK for the aspects it left blank.
# The main fill is handed thirty-odd of eBay's aspects at once and asked to
# fill what it can; what it does with the ones it is unsure of is silently
# nothing, which is how a listing reaches eBay with Subject, Era, Occasion,
# Packaging and Character empty while eBay's own suggester offers all five
# from the same photos. On (default), the blanks get one more, narrower ask
# over a short list, with four photos rather than eight. It is a second vision
# call per listing, so set it to 0 to turn it off.
# SPECIFICS_COVERAGE=1

# Whether a draft that turns on an identification (a signature, an edition, a
# variant) gets LOOKED UP — a second vision call with web search inside it —
# before it is returned. auto: when the draft shows a sign it matters.
# always: every draft. off: never.
#
# Unset, the default follows the identifier backend: auto on Google, off on
# Claude. On Claude the lookup is a server-tool loop that searches
# sequentially inside the identify request, which adds a minute or more per
# item and multiplies through a bulk batch. Gemini's grounded lookup is one
# call that searches server-side, and it is what puts a SOURCE under the
# suggested price — which is the point of identifying on Google.
# Set this to pin it either way.
# RESEARCH_PASS=auto

# Whether a draft that is ARTWORK -- a print, a poster, a painting -- and does
# not yet name its artist gets looked up: a reverse image search (SERPAPI_KEY
# below, when set) plus a vision call with web search that reads the print
# first, recognises the image second, and confirms against a catalogue or an
# auction record before naming the artist and the work. auto (default): art
# drafts that lack an artist. off: never. Narrow where RESEARCH_PASS is wide,
# which is why this one is on.
# ART_LOOKUP=auto
# --- the experts -----------------------------------------------------------
# A vertical -- art, denim -- is an "expert": its rules, its scorer, and
# (for art) its lookup and data sources, in one directory under
# backend/services/experts. The point of them is ROUTING: every item used to
# be drafted under every vertical's rules, so a coffee mug paid for the
# Levi's selvedge rule and the plate-mark rule, and every new vertical made
# the prompt longer and the existing ones vaguer.
#
# off (the default, for now): every enabled expert speaks about every item,
# which is exactly what the concatenated rules did before experts existed --
# so turning the framework on changed nothing. on: each item is drafted under
# the rules that apply to it. Grouping is never routed whatever this says; it
# runs before there is a draft to route on, and a routing miss there makes two
# listings out of one item.
# EXPERT_ROUTING=off
# How many experts may speak about one item. An item really can be two things
# at once (a framed print of a denim advertisement); a third has never been
# needed, and would put us back where we started.
# EXPERT_MAX_ACTIVE=2
# How strong a match must be before an expert's rules ride along:
# none | weak | likely | certain. weak on purpose -- routing an expert IN that
# was not needed costs some tokens, and routing one OUT that WAS needed drafts
# a hand-signed lithograph with no art rule at all.
# EXPERT_MATCH_FLOOR=weak
# Per-expert kill switches: on | off | auto. ART_LOOKUP=off above is still
# honoured as an alias for EXPERT_ART=off.
# EXPERT_ART=auto
# EXPERT_DENIM=auto
# --- teaching an expert with a reference link -------------------------------
# A seller (or you, app-wide) saves a URL -- a catalogue raisonné, a Levi's
# dating chart, a maker's mark reference -- with a line about what it is for.
# The expert reads it whenever it drafts that kind of item, with no deploy.
#
# HOW MANY one account may save per expert. A cap, because an uncapped list
# both stuffs the prompt and turns the page fetcher into an amplifier pointed
# at somebody else's server -- and because only the first few are ever read
# into a prompt anyway, so the twenty-first is a row nobody will see.
# KNOWLEDGE_PER_ACCOUNT=20
#
# There is no key to set. What there IS, and what is worth knowing before you
# enable this for sellers: the app makes an outbound HTTPS request to an
# address a user chose. services/reference_fetch is the guard -- https only,
# every redirect hop re-validated, every resolved address checked against the
# private, loopback, link-local and shared-address ranges (169.254.169.254 is
# the cloud metadata endpoint), a bounded redirect chain, a streaming size cap
# and a deadline. Its docstring is also honest about the one case it narrows
# rather than closes.
#
# And the page's CONTENT is untrusted however safely it was fetched. The
# seller's NOTE is an instruction; the fetched page is evidence, fenced, in
# the user turn, never in a system prompt, and the pass that summarises it is
# given no tools at all. See services/experts/knowledge.
# Reverse image search for that lookup: SerpApi's Google Lens engine
# (https://serpapi.com). Optional -- without it the lookup runs on the model's
# own recognition plus web search. Needs R2 (above): the engine fetches the
# photo from the bucket's URL.
SERPAPI_KEY=
# --- sold prices ------------------------------------------------------------
# An asking price is what somebody hopes for; a sold price is what somebody
# paid, and on art the gap is enormous -- an unsold print can sit at an
# optimistic number for years, and every one of those listings is a "comp" to
# a keyword search.
#
# services/pricing.sold_comps now queries eBay's Marketplace Insights API for
# real sold prices, using the SAME application credentials as the taxonomy and
# comp lookups (EBAY_CLIENT_ID / EBAY_CLIENT_SECRET) -- there is no extra key
# to set here. What there IS is an approval: Marketplace Insights is a limited
# release, and the endpoint answers 403 until eBay grants this application the
# `buy.marketplace.insights` scope. Apply through the eBay developer console.
#
# Until then nothing breaks and nothing lies: the first call reports a failed
# source (so the price card says we could not look, rather than "no comparable
# listings found"), the denial latches so it does not cost a request per item,
# and asking prices carry the estimate exactly as they did. The scope is
# picked up on the next restart after it is granted.
# Long-side pixels of the photo copies sent to vision calls. 1092 is the
# largest size Claude never downscales (bigger costs ~2x the image tokens for
# no extra detail); raise only if a model change makes higher resolution pay.
# VISION_IMAGE_SIDE=1092

# ---------------------------------------------------------------------------
# Monetization: AI tokens (optional — leave off for free/self-hosted installs)
# The app is free; AI features spend tokens. Each account gets a monthly free
# allowance (resets on the 1st, UTC; no rollover); when it runs out, users buy
# token packs (Stripe) — purchased tokens never expire. Requires DATABASE_URL.
# ---------------------------------------------------------------------------
# Master switch. Off (default): every AI feature is free, no login required.
TOKENS_ENABLED=
# Monthly free allowance per account (default 50 ≈ 10 AI listing drafts).
FREE_TOKENS_PER_MONTH=
# Stripe: secret key (sk_live_/sk_test_) enables pack purchases; the webhook
# signing secret (whsec_...) comes from registering an endpoint for the
# checkout.session.completed event at:
#   https://<your-domain>/api/tokens/webhook
# The webhook is a safety net — purchases also confirm client-side after the
# Checkout redirect — but register it so credits survive a closed browser tab.
#
# STRIPE_API_SECRET_KEY / STRIPE_API_WEBHOOK_SECRET are read as second names
# for these two (the production keyset is deployed under the first). The
# canonical name wins when both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-feature token prices (defaults tuned for Opus-tier vision at ~40-60%
# gross margin; re-tune if you point VISION_MODEL at a cheaper tier):
# TOKENS_COST_IDENTIFY=5     # full AI listing draft (single or per bulk item)
# TOKENS_COST_REFINE=1       # free-form AI refine instruction
# TOKENS_COST_SPECIFICS=2    # standalone "Autofill item specifics"
# TOKENS_COST_SHELF_SCAN=2   # Shop Mode shelf scan
# TOKENS_COST_IMAGE_AI=1     # per photo: background removal / auto-clean / smart crop

# ---------------------------------------------------------------------------
# Background removal: which engine cuts the item out.
#
# BG_ENGINE picks it, and the value is the FIRST entry of a chain that always
# ends at "local" -- so a deploy that sets none of these keeps working exactly
# as it always has and spends nothing per photo.
#   "auto"     (default) whichever remote engines have keys, then local.
#   "removebg" remove.bg's API (REMOVEBG_API_KEY). The engine this was asked
#              for by name; owned by Canva. HEADS UP: its standalone API shuts
#              down 2026-12-01 and migrates to Leonardo.Ai, so keep
#              LEONARDO_API_KEY set alongside it and the switch is this one
#              line. Its FREE tier only ever returns a 0.25MP (625x400)
#              preview, which is below this app's 1600px output -- the engine
#              refuses such a result and says so rather than upscaling it, so
#              a free key is good for wiring the integration up and not for
#              serving sellers.
#   "leonardo" Leonardo.Ai (LEONARDO_API_KEY), remove.bg's named successor.
#   "local"    the in-process rembg model below. Free per photo, ~104s per
#              inference on a 4GB machine, and the only engine that needs no
#              credentials -- which is why it is always the floor.
# Naming an engine whose key is missing falls back to the rest of the chain
# (with a warning at startup) rather than failing every photo. A remote engine
# that fails never loses the photo either: the original is kept and the reason
# (bad key / out of credits / rate limit) is surfaced to the seller.
# Per-image cost is real -- roughly $0.10 on both of these -- against 1
# TOKENS_COST_IMAGE_AI token charged per photo. /api/ready reports the chain
# under image_engine, which is how an expired key gets noticed before it shows
# up as cutouts quietly getting worse.
BG_ENGINE=auto
REMOVEBG_API_KEY=
LEONARDO_API_KEY=
# BG_API_MAX_SIDE: the copy a remote engine is sent (default 2048). The output
#   is only ever 1600px, so a full 4032px upload is minutes and hundreds of MB
#   across a big batch for no visible gain.
# BG_API_TRIES: attempts per photo (default 4). 429 and 5xx retry with
#   backoff, honouring Retry-After; a 402 or 403 never retries, because a spent
#   account is not a blip.
# BG_API_TIMEOUT: seconds per attempt (default 30).
#
# The in-process model (rembg), one pass per photo, the item composited on
# white. Needs no credentials.
# REMBG_MODEL: "isnet-general-use" (best edges; needs ~4GB) or "u2netp"
#   (4MB, fast, rougher) for a memory-constrained host.
# REMBG_MAX_SIDE: the copy handed to the model (default 1024, matching
#   isnet's own input). Not a speed dial: both models normalize their input
#   to a fixed tensor, so a smaller copy is upscaled straight back.
# REMBG_THREADS: threads onnxruntime may use for one inference (default: one
#   fewer than the CPUs we can see, so uvicorn can still answer its health
#   check while a batch runs).
# REMBG_WAIT_SECONDS / REMBG_BATCH_WAIT_SECONDS: how long a caller queues for
#   the single inference slot before giving up (defaults 25 / 300). Someone
#   watching the studio's spinner wants a fast "busy, try again"; a photo in
#   a batch has no one to tell and no retry, so it waits.
# REMBG_ALPHA_LOW / REMBG_ALPHA_HIGH: how the model's soft matte is hardened
#   (defaults 64 / 192). Below LOW is dropped, above HIGH is kept solid, the
#   band between is the edge. Raise LOW if backgrounds ghost through; lower
#   it if cutouts bite into the item.
# REMBG_MIN_COVERAGE: a matte keeping less than this share of the frame
#   (default 0.005) found no item, and the photo is kept as shot instead. It
#   sat at 0.02 and refused a necklace, which measures 0.015. This is the one
#   gate a REMOTE matte also answers -- "found nothing at all" is true whoever
#   produced it. The others below are fitted to the local model's failures and
#   are deliberately not applied to a paid engine's output.
# The local model's other gates, all with code defaults and no line here:
#   REMBG_MIN_SOLIDITY (0.4), REMBG_MIN_LARGEST_REGION (0.6),
#   REMBG_MIN_BBOX_FILL (0.3), REMBG_MIN_BBOX_FILL_ONE (0.05),
#   REMBG_COMPANION_SHARE (0.25), REMBG_MAX_OBJECTS (4),
#   REMBG_OBJECTS_COVER (0.85), REMBG_SHAPE_SIDE (160), REMBG_HOLE_*.
# A photo OF A PICTURE never takes a model's matte: it gets a filled rectangle
# from its own border instead (services/artwork), tuned by the ART_* family --
# ART_BORDER_SIDE, ART_SURROUND_DIST, ART_MIN_RECT_FILL, ART_MIN_AREA,
# ART_BLEED_SPAN, ART_MARGIN and friends. ART_ALPHA_RECT_FILL (0.9) is the one
# a model's matte touches: how nearly it must fill the best rectangle that can
# be drawn around it -- at ANY angle, since a print photographed hand-held is a
# rectangle that happens to be tilted -- before its outer SHAPE may be treated
# as a picture's edge rather than as a subject lifted out of the picture.
# ART_FIT_COARSE (3) is the step of that angle sweep.
# ART_LOCAL_BORDER (on): whether the built-in model may be the one asked where
#   a picture's edge is when the geometric scan cannot find it. It was paid
#   engines only, which meant it never ran here -- no key, no second look, and
#   framed prints and printed trays came back exactly as shot while shirts came
#   back cut out. Only the outer shape is ever read, whoever drew it; "off"
#   restores the old behaviour.
REMBG_MODEL=isnet-general-use
REMBG_MAX_SIDE=1024

# BULK_DRAFT_WORKERS: how many items of one bulk batch are drafted at the same
#   time (default 3). Drafting an item is five to nine Anthropic calls and a
#   handful of eBay lookups, nearly all of it spent waiting on somebody else's
#   server, so this is what stops a forty-item batch taking the better part of
#   an hour. The ceiling is the machine, not the API: each worker holds a
#   listing's photos as base64 and crops the full-size originals, alongside the
#   cutout model. Set it to 1 to go back to one item at a time.
BULK_DRAFT_WORKERS=3

# Content-aware auto-straightening: a vision pass over the originals, before
# the cutout, for the photo where the ITEM lies sideways or on its head --
# which EXIF cannot tell. Two looks per turn: a screen written around how an
# item sits (standing, hanging, worn, laid flat, a detail) with readable text
# winning, then the photo at all four quarter-turns and the model must pick
# the proposal for it to ship. Flat-lays and close-ups without text are
# never turned. See backend/services/orient.py. Best-effort and bounded:
# anything it cannot answer for stays as shot.
# AUTO_ORIENT=off disables the pass entirely.
# ORIENT_MODEL: the model it asks (default: VISION_MODEL).
# ORIENT_TIMEOUT_SECONDS: per call (default 60), no retries.
# ORIENT_BUDGET_SECONDS / ORIENT_SECONDS_PER_PHOTO: the whole pass gets the
#   larger of the two (defaults 150 / 2 per photo), so a listing's photos
#   are bounded tightly and a 250-photo bulk batch is answered for in full;
#   past the budget the rest stay as shot.
# AUTO_ORIENT=on

# ---------------------------------------------------------------------------
# eBay API (optional). Leave blank to run in "dry-run" mode, where the app
# builds the exact API payloads and saves them to data/exports/ instead of
# calling eBay. Fill these in when you have a developer account to go live.
#
# Create an app at https://developer.ebay.com/. Sellers connect their OWN
# eBay account through the in-app OAuth flow (EBAY_CLIENT_ID +
# EBAY_CLIENT_SECRET + EBAY_RUNAME are all that needs); the server-level user
# token further down is only for a single-tenant install.
# ---------------------------------------------------------------------------

# "sandbox" or "production"
EBAY_ENV=sandbox

# Bi-directional sync: how many listing-detail calls run at once when importing
# the seller's existing store (see README). Optional.
# EBAY_SYNC_WORKERS=6

# How many existing records a sync reads before deciding what's new — the
# duplicate check's field of view, not a store-size limit. It has to stay wider
# than the store (one item can hold an active row, an ended mirror and a sold
# record at once); a record the read misses is one the dedupe can't match.
# Optional.
# EBAY_SYNC_KNOWN_LIMIT=10000

# How long a passing eBay policy/location check is trusted before the next
# publish re-verifies the saved ids against the connected account, in seconds.
# Lower catches a change made on eBay sooner; higher spends fewer Account API
# calls. Unparseable values fall back to 600 with a warning rather than
# stopping the app from booting. Optional.
# EBAY_POLICY_VERIFY_TTL=600

# How many listings one bulk price drop touches when the caller names them
# (POST /api/ebay/lower-prices). Each is a serial eBay revise, so this keeps the
# request inside the gateway's patience; the rest are reported for a second
# run. The dashboard's "Lower all…" does NOT use it — that is an uncapped
# background job over the whole group. Optional.
# BULK_PRICE_CAP=40

# How many listings one "Send offers" run offers (Dashboard → Suggested actions
# → Send offers). eBay's Negotiation API takes exactly ONE listing per request,
# so a run is that many serial calls and the same gateway budget as the price
# cap above applies; the rest are reported for a second run. Optional.
# BULK_OFFER_CAP=40

# How many listings one "Enrich all" run fills in (Dashboard → Suggested
# actions → Fill in details). Each is a Claude vision pass over that listing's
# photos and then an eBay revise, so it is well below the price cap above; the
# rest are reported for a second run. Optional.
# BULK_ENRICH_CAP=25

# How many listings one CSV export may carry (Sell → Export CSV). The response
# is streamed a page at a time, so this is a guard on the size of the download
# and the length of the walk, NOT a product limit -- the file is the seller's
# own inventory and is meant to be all of it. Past the cap the answer says so
# in its X-Export-Truncated header and the app warns rather than handing over a
# short file that looks complete. Optional.
# LISTING_EXPORT_CAP=25000

# A user OAuth access token (or paste a long-lived one for testing).
EBAY_OAUTH_TOKEN=

# --- Serving the app on more than one hostname ------------------------------
# Leave BOTH of these blank unless the app answers on several origins. Blank is
# the single-origin behaviour: every URL is built from the incoming request and
# nothing below applies.
#
# They exist because OAuth is the one thing that cannot follow the request. A
# marketplace returns the seller to the ONE callback URL registered against the
# credential -- eBay resolves EBAY_RUNAME to a single accepted URL, Etsy and
# Depop match redirect_uri exactly -- while the CSRF nonce cookie set when the
# flow starts is host-only. Start a connect on a hostname the callback does not
# come back to and it arrives with no cookie, is refused as "expired", and
# leaves the seller on a hostname where their session cookie does not exist
# either, so they also appear logged out.
#
# OAUTH_ORIGIN is the origin those callback URLs point at. A connect started
# anywhere else is sent here first (carrying a 60-second connect ticket, since
# the session cookie cannot cross) and the seller is returned to the origin
# they came from when it finishes. Set it to whichever hostname is registered
# in the marketplace consoles -- NOT necessarily the one you advertise.
OAUTH_ORIGIN=

# Comma-separated: every origin this app is served on, and the only ones a
# connect flow will return a seller to. This list is the open-redirect guard --
# the Host header is client-controlled, so an origin is trusted only if named
# here. Include OAUTH_ORIGIN itself.
#   APP_ORIGINS=https://app.example.com,https://example.fly.dev
APP_ORIGINS=

# Recommended: "Sign in with eBay" OAuth. Set these three and users can click
# "Connect eBay" in the app - no manual token/policy pasting. CLIENT_ID/SECRET
# come from your eBay app keyset; RUNAME is the redirect URL name whose accepted
# URL points at https://<your-domain>/api/ebay/callback
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# Fallback only (if not using the connect flow): a static refresh token.
EBAY_REFRESH_TOKEN=

# Shipping labels need no server setting: each seller connects their OWN
# EasyPost API key under Settings -> EasyPost shipping labels, and postage is
# billed to that account. There is deliberately no app-wide EasyPost key.

# eBay buyer messages (Message API). Also LIMITED-RELEASE: eBay must approve
# commerce.message for your keyset before the scope can be requested at all,
# and asking for it unapproved breaks the ENTIRE connect flow — not just
# messaging. Leave this empty until eBay has approved you. Once set to 1 the
# header grows an inbox icon showing buyer conversations only (never eBay's
# own system mail), and already-connected sellers reconnect once to grant it.
EBAY_MESSAGING_ENABLED=

# Marketplace Account Deletion notifications - REQUIRED for Production keysets.
# Invent a token (32-80 chars: letters/digits/_/-, e.g. `openssl rand -hex 32`)
# and paste the SAME value here and on developer.ebay.com -> Application Keys ->
# Alerts & Notifications, with the endpoint URL:
#   https://<your-domain>/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Only needed if a proxy rewrites your scheme/host: the exact endpoint URL as
# registered with eBay (used in the challenge hash). Blank = derived from the
# request.
EBAY_DELETION_ENDPOINT=

# Single-tenant install only: business policy IDs and merchant location for
# the server-level eBay account. A seller who connects through OAuth has
# theirs read from eBay and saved per account, and these are ignored.
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# ---------------------------------------------------------------------------
# WHICH MARKETPLACES THE APP OFFERS AT ALL — read this before the two
# sections below, because it overrides both.
#
# eBay is always on. Etsy is offered in production (fly.toml names it) and
# is what the eBay → Etsy crosspost posts to; Depop is built and withheld
# from every seller-facing surface — no connection card, no publish chip, no
# inbox source, no editor panel — until its partner credentials arrive.
#
# WITHHELD IS THE CODE'S DEFAULT. Leave this blank and the app offers eBay
# alone, so a laptop, CI and the mobile build all agree without anyone
# setting anything; a deploy that wants Etsy says so, in one reviewable
# line. That is the property commenting the providers out would have given
# us, without the dead code.
#
#   MARKETPLACES_ENABLED=            # blank/unset -> eBay alone
#   MARKETPLACES_ENABLED=ebay,etsy   # what production runs
#   MARKETPLACES_ENABLED=all         # everything built, Depop included
#
# So if you have set every ETSY_* variable below and no Etsy card appears,
# this is why — set it here first. Unknown keys are ignored and reported in
# config_warnings() (see /api/admin/diagnostics), so a misspelling says so
# instead of silently leaving the marketplace hidden.
#
# eBay is always enabled whatever this says: core publish and revise routes
# reach for it by name, so a list that left it out would 500 the publish
# button rather than launch a leaner app. Omitting it is reported, not obeyed.
# ---------------------------------------------------------------------------
MARKETPLACES_ENABLED=

# ---------------------------------------------------------------------------
# Etsy (optional — and offered only when MARKETPLACES_ENABLED above names
# it: these variables configure Etsy, they do not offer it). Set all three
# and an "Etsy" card appears under Settings -> Cross-posting marketplaces;
# sellers click Connect Etsy and can then include Etsy in any publish, and
# crosspost their eBay store to it. Leave any blank and Etsy stays hidden,
# with the card naming what is missing.
#
# Register an app at https://www.etsy.com/developers/register. The app's
# "keystring" is the client id and its "shared secret" sits beside it on the
# same page. The consent flow is PKCE, so the secret never reaches the
# browser — but since 2026-02-09 EVERY request to Etsy's API must send the
# x-api-key header as `keystring:sharedSecret`, the token exchange included;
# the keystring alone is refused. A keystring without the secret is reported
# by config_warnings() rather than left to fail at the first connect. The
# redirect URI must be registered on the app EXACTLY as set here:
#   https://<your-domain>/api/etsy/callback
#
# The app TYPE decides who may connect, and it is the usual first-connect
# surprise. A Seller app — what Etsy registers by default — can only ever be
# authorized by the single Etsy account that owns it; anyone else clicking
# Connect Etsy stops on Etsy's own page reading "An error occurred / Only the
# app owner may authorize a seller app". Etsy refuses there, before any
# redirect back, so no amount of config here changes it:
#   - Connecting your OWN shop and still blocked? The browser is signed in as
#     a different Etsy account than the one that registered the keystring.
#     Sign out of Etsy, sign back in as the owner, retry.
#   - Want other sellers to connect? Etsy tiers this in THREE steps, not two,
#     and Commercial Access cannot be requested straight from a Seller app:
#       1. Seller app  — your shop only. The default, and where the error
#          above comes from.
#       2. Personal app — your shop plus a handful of others (Etsy documents
#          the ceiling as 4). Registered in the Developer Portal; reviewed
#          more deeply than a Seller app.
#       3. Commercial Access — unlimited sellers. Requires an APPROVED
#          Personal app first; requested on that app.
#     Review looks at the API Terms of Use (the app's public home page
#     included) and the caching rules in Section 1 of those terms. Confirm
#     the current tiers and ceiling in the Developer Portal — they are Etsy's
#     to change, not ours.
# Reaching that page at all is proof ETSY_CLIENT_ID and ETSY_REDIRECT_URI are
# registered correctly — a wrong one fails earlier, before the consent screen.
#
# ETSY_ACCESS_TIER is which of those three you are on: seller (the default,
# and what an unset or unreadable value reads as), personal, or commercial.
# It changes nothing about who gets through — ETSY_OWNER_EMAILS below does
# that — but it is what the app tells a seller it is holding them back FOR,
# and it sets the ceiling the warning below counts against. Leave it blank on
# a newly registered app: that IS a seller app until Etsy says otherwise.
# (Thryft's own production deploy sets it to `personal` in fly.toml — Etsy
# approved the app at that tier on 2026-08-31.)
#
# So sellers aren't walked into that dead end, put the app owner in
# ETSY_OWNER_EMAILS (comma-separated, case-insensitive). NOTE which email that
# is: the one they sign in to THIS app with, not their Etsy login — it is
# matched against the account record, which is all the app knows before a
# connect.
#
# They go on connecting normally; everyone else gets a "Pending approval" card
# under Settings -> Cross-posting marketplaces instead of a Connect button,
# and a connect that slips through anyway (from a page loaded before you set
# this) lands back in the app with the reason rather than on Etsy's error.
#
# The list is comma-separated because step 2 above makes it useful: on a
# Personal app the named sellers can genuinely authorize, so this doubles as
# the beta allowlist — add the handful you are onboarding and everyone else
# keeps the pending card. On a Seller app only the keystring's owner can get
# through, so a second address there just moves where the refusal happens.
#
# Which is why naming MORE sellers than Etsy seats is worth a warning rather
# than a shrug, and config_warnings() (see /api/admin/diagnostics) raises one:
# the overflow skips this app's pending card and is refused on Etsy's page
# instead, which is the dead end this whole section exists to prevent. Nothing
# in the app can tell a named seller from a seated one, so the count is the
# only signal there is. ETSY_APP_SEATS overrides the ceiling if Etsy moves it;
# leave it blank to use the tier's own number (1 / 4 / unlimited).
#
# Leave ETSY_OWNER_EMAILS blank and NOBODY is gated: with no owner named the
# app cannot tell the owner from anyone else, and guessing would lock you out
# of your own shop — so the gate stands down rather than guessing.
#
# Standing down is NOT the same as Etsy being open, and this is the trap:
# below Commercial Access the wall is still there, and now nothing here holds
# anyone back from walking into it. Every seller is sent to Etsy and all but
# the seated ones stop on the error page above. It is the one Etsy
# misconfiguration that looks like success from inside the app — credentials
# set, card offered, Connect button live — so it is called out in two places:
# config_warnings() raises a line for the operator (see
# /api/admin/diagnostics, which also reports it as etsy_access_unverified),
# and the seller gets a caution on the Etsy card plus a confirm before the
# redirect, naming what Etsy is about to say and what it means. They are
# still let through: on a deploy with no roster the person pressing Connect
# is usually the owner, for whom it simply works.
#
# Set ETSY_ACCESS_TIER=commercial the day Etsy grants it and the gate retires
# itself, owner list and all — warning, caution and confirm with it.
# (ETSY_COMMERCIAL_ACCESS=true is the older name for that and still means
# exactly the same thing.)
# ---------------------------------------------------------------------------
ETSY_CLIENT_ID=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
ETSY_ACCESS_TIER=
ETSY_OWNER_EMAILS=
ETSY_APP_SEATS=
ETSY_COMMERCIAL_ACCESS=

# ---------------------------------------------------------------------------
# Depop (optional, and currently WITHHELD — see MARKETPLACES_ENABLED above).
# Depop's Selling API is PARTNER-GATED: apply through
# Depop's partnerships team (partnerapi.depop.com) to get credentials. The
# OAuth endpoints are env vars because they arrive with partner onboarding —
# fill in all five and the Depop card + publish chip light up. Until then
# Depop shows as "not configured" and never blocks anything.
# ---------------------------------------------------------------------------
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
DEPOP_AUTH_URL=
DEPOP_TOKEN_URL=
# Register with Depop as: https://<your-domain>/api/depop/callback
DEPOP_REDIRECT_URI=
# Optional overrides (defaults are right once partner access is granted):
# DEPOP_API_BASE=https://partnerapi.depop.com
# DEPOP_SCOPES=products_read products_write

# ---------------------------------------------------------------------------
# Admin diagnostics (optional, but see below). /api/health is public and
# answers liveness, the UI's capability flags, and the build sha the deploy
# gate polls -- nothing else. Everything an operator needs to tell "not
# configured" apart from "misconfigured" (which env vars are unset, the R2
# bucket and its last error, free disk, Stripe mode, database state) lives at
# /api/admin/diagnostics behind this token, sent as the x-admin-token header.
#
# UNSET MEANS CLOSED, not open: leaving this blank denies the endpoint
# entirely. An absent secret reading as "no check required" is how it would
# quietly become public again on a deploy that forgot to set it.
#
#   curl -H "x-admin-token: $ADMIN_TOKEN" https://<host>/api/admin/diagnostics
#
# The in-app operator console (the Admin tab: platform numbers, accounts,
# billing, compliance queues, audit log) is separate from this token. It is
# gated by an account role instead, granted only from a shell:
#
#   python3 scripts/grant_superadmin.py you@example.com          # grant
#   python3 scripts/grant_superadmin.py you@example.com --revoke # revoke
#
# (on Fly: `fly ssh console` first). There is no env var that makes a
# superadmin, deliberately -- a list here would re-assert on every boot, so
# a typo'd address would become a standing grant to whoever registers it.
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Error capture and logging
# ---------------------------------------------------------------------------
# LOG_LEVEL has been read since the first commit (backend/config.py) and was
# never written down here. INFO by default; DEBUG is genuinely noisy on this
# app because the eBay account-deletion endpoint is hit 1-2 times a MINUTE.
LOG_LEVEL=INFO
#
# Failures are recorded to the `error_events` table -- one row per DISTINCT
# failure with a count, not one per occurrence -- which is what the console's
# Errors tab reads and what the daily triage job works from. Set to 0 to turn
# capture off entirely: logging to stdout is unaffected, and so is the rest of
# the app. It is here as a kill switch, because this is new machinery on the
# path of every log call and turning it off should not need a code change.
ERROR_CAPTURE_ENABLED=1
#
# How long a failure nothing has seen again is kept. Aggregation already bounds
# the table by how many DISTINCT things are broken rather than by traffic, so
# this only bounds how long a FIXED bug keeps being listed. Pruned by the same
# daemon that sweeps the volume.
ERROR_TTL_DAYS=30
#
# Browser crash reports accepted per client per rate-limit window. The ingest
# route is deliberately unauthenticated -- a crash in the app shell means there
# may be no session to authenticate with -- so this is what stops it being used
# to fill the table. Generous enough for a genuinely broken page.
CLIENT_ERROR_MAX_PER_WINDOW=20
#
# The daily triage job's own door onto the error report (/api/ops/error-feed).
# Deliberately NOT ADMIN_TOKEN: that one also opens /api/admin/diagnostics,
# whose payload carries raw database and object-store exception text -- the
# Neon host, the database role, the R2 account id. A scheduled job that reads
# which bugs are open has no business holding that, and a credential living in
# CI is the one most likely to leak. UNSET MEANS CLOSED, like ADMIN_TOKEN:
# without it the feed answers 401 to everyone, including the job.
#
#   fly secrets set --stage ERROR_FEED_TOKEN="$(openssl rand -hex 32)"
#
# (--stage because this app runs a single machine with min_machines_running=1,
# so an unstaged set restarts production immediately -- see README.)
ERROR_FEED_TOKEN=
