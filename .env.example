# ---------------------------------------------------------------------------
# eBay Listing Generator - configuration
# Copy this file to ".env" and fill in the values you have.
# Everything except ANTHROPIC_API_KEY is optional; the app degrades gracefully.
# ---------------------------------------------------------------------------

# REQUIRED: powers image identification ("lens") and listing content generation.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Postgres (e.g. Neon) for durable listing history + accounts.
# Neon gives a URL like: postgresql://user:pass@ep-xxx.neon.tech/db?sslmode=require
# Leave blank to run purely off the local filesystem (accounts disabled).
DATABASE_URL=

# Signs login session cookies. Set a long random value in production so
# sessions survive restarts (e.g. `openssl rand -hex 32`).
SECRET_KEY=

# Encrypts the marketplace refresh tokens stored in the database. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave blank and a key is derived from SECRET_KEY, so a local or self-hosted
# deployment is protected with no extra setup. Set it explicitly if SECRET_KEY
# might ever be rotated: a token cannot be read back under a different key, and
# those sellers have to reconnect (they see "not connected", never an error).
TOKEN_ENCRYPTION_KEY=

# Optional: Cloudflare R2 (or any S3) for durable images that survive
# restarts. ONLY the three credentials below are needed — create an R2 API
# token (dashboard -> R2 -> Manage API tokens) and copy its Access Key ID +
# Secret Access Key, plus your account id from the R2 overview page.
# Leave all three blank to serve images off local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: bucket name (default "thryft-images", auto-created on first use).
R2_BUCKET=
# Optional: the bucket's public base URL (its r2.dev URL or a custom domain),
# no trailing /. When set, photos are served straight from Cloudflare; when
# blank, the app hands out short-lived presigned URLs instead — no public
# bucket needed.
R2_PUBLIC_BASE_URL=

# Models used for vision identification and text generation (optional overrides).
VISION_MODEL=claude-opus-4-8
CONTENT_MODEL=claude-opus-4-8

# How the post-identify enrichment runs. v2 (default) folds tag reading, item
# specifics, and the maker hunt into ONE vision call (plus a conditional maker
# verify) — the same quality checks in ~2 calls instead of 4-6. v1 restores
# the original multi-call chain if v2 ever misbehaves.
# IDENTIFY_CHAIN=v2
# Long-side pixels of the photo copies sent to vision calls. 1092 is the
# largest size Claude never downscales (bigger costs ~2x the image tokens for
# no extra detail); raise only if a model change makes higher resolution pay.
# VISION_IMAGE_SIDE=1092

# ---------------------------------------------------------------------------
# Monetization: AI tokens (optional — leave off for free/self-hosted installs)
# The app is free; AI features spend tokens. Each account gets a monthly free
# allowance (resets on the 1st, UTC; no rollover); when it runs out, users buy
# token packs (Stripe) — purchased tokens never expire. Requires DATABASE_URL.
# ---------------------------------------------------------------------------
# Master switch. Off (default): every AI feature is free, no login required.
TOKENS_ENABLED=
# Monthly free allowance per account (default 50 ≈ 10 AI listing drafts).
FREE_TOKENS_PER_MONTH=
# Stripe: secret key (sk_live_/sk_test_) enables pack purchases; the webhook
# signing secret (whsec_...) comes from registering an endpoint for the
# checkout.session.completed event at:
#   https://<your-domain>/api/tokens/webhook
# The webhook is a safety net — purchases also confirm client-side after the
# Checkout redirect — but register it so credits survive a closed browser tab.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-feature token prices (defaults tuned for Opus-tier vision at ~40-60%
# gross margin; re-tune if you point VISION_MODEL at a cheaper tier):
# TOKENS_COST_IDENTIFY=5     # full AI listing draft (single or per bulk item)
# TOKENS_COST_REFINE=1       # free-form AI refine instruction
# TOKENS_COST_SPECIFICS=2    # standalone "Autofill item specifics"
# TOKENS_COST_SHELF_SCAN=2   # Shop Mode shelf scan
# TOKENS_COST_IMAGE_AI=1     # per photo: background removal / auto-clean / smart crop

# ---------------------------------------------------------------------------
# Photo pipeline engines. BG_ENGINE picks who strips backgrounds:
#   "pixian" | "photoroom" | "adobe" | "local", or unset ("auto") = Pixian
# when its keys are present, otherwise the free in-process model.
# NOTE: auto mode opting into Pixian is deliberate — it's the budget engine
# (~1/10th of Photoroom's per-image price), so configuring its keys IS the
# opt-in. The pricey engines (Photoroom, Adobe) never run unless BG_ENGINE
# names them: their key alone must not quietly spend money per photo.
# BG_ENGINE=

# Pixian.ai — the budget remote engine; runs automatically once keys are set.
PIXIAN_API_ID=
PIXIAN_API_SECRET=

# Photoroom (https://photoroom.com/api) — the highest-quality cutouts (it's
# what eBay's own listing flow uses), priced per image. DISABLED until BOTH
# lines below are set: uncomment the key with a real value AND set
# BG_ENGINE=photoroom above — the key alone never spends money per photo.
# When enabled: batches run PHOTO_BATCH_WORKERS photos in parallel (each is a
# ~1-2s API wait), Adobe backs it up when configured, and a Photoroom failure
# is surfaced loudly with the photo kept as shot — it deliberately does NOT
# fall back to the weaker local model, which used to save mangled cutouts with
# no clue why. Rate limits/5xx retry automatically with backoff (BG_API_TRIES,
# default 4); payloads are capped at BG_API_MAX_SIDE (default 2048px).
# PHOTOROOM_API_KEY=
# PHOTO_BATCH_WORKERS=8   # photos processed through a remote engine at once

# Adobe Lightroom + Photoshop (Firefly Services), BG_ENGINE=adobe (or as
# Photoroom's backup): the Lightroom API applies the "studio" develop preset,
# then the Photoshop Remove Background service does the cutout.
#
# Get a server-to-server OAuth credential from a project at
# https://developer.adobe.com/console with the Lightroom and Photoshop APIs
# enabled. BOTH values are required (a single API key is not enough for
# Adobe's server-to-server auth). R2 (above) must ALSO be configured —
# Adobe's async APIs move files via presigned URLs, so R2 is the hand-off
# storage.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
# Optional: URL to your own exported Lightroom preset (.xmp) to use instead of
# the bundled studio look (backend/assets/studio-preset.xmp).
ADOBE_STUDIO_PRESET_URL=
# Optional overrides (defaults are right for standard Firefly Services access):
# ADOBE_SCOPES=openid,AdobeID,firefly_api,ff_apis
# ADOBE_IMS_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
# ADOBE_IMAGE_API_BASE=https://image.adobe.io

# FREE DEFAULT (rembg, in-process) — the fallback whenever no remote engine
# is selected; needs no credentials.
# REMBG_MODEL: "isnet-general-use" (default, best quality) or "u2netp"
#   (smaller/faster/lower-quality) if the host is memory-constrained.
# REMBG_MAX_SIDE: size of the copy handed to the model (default 640). NOT an
#   inference-cost dial, despite appearances: both bundled models normalize
#   their input to a fixed tensor first (isnet 1024x1024, u2netp 320x320), so
#   a smaller copy is upscaled straight back before any work happens —
#   measured on two pinned cores, 640 and 1024 finish within 2% of each other.
#   Going below the model's own input size costs quality for nothing. It does
#   control memory (lower it on a 2GB box) and the resolution the refinement
#   passes run at. Production sets 1024 to match isnet.
# REMBG_STUDIO_MAX_SIDE: same, for the studio's one-off 'Remove background'
#   (defaults to REMBG_MAX_SIDE).
# REMBG_THREADS: threads onnxruntime may use for one inference (default: one
#   fewer than the CPUs we can see). The default deliberately leaves a core
#   free -- uvicorn still has to answer its health check while a batch runs,
#   and a machine that misses those checks gets replaced, killing the batch.
# REMBG_WAIT_SECONDS / REMBG_BATCH_WAIT_SECONDS: how long a caller queues for
#   the single inference slot before giving up (defaults 25 / 300). They differ
#   on purpose. Someone watching a spinner wants a fast "busy, try again"; a
#   photo in a background batch has no one to tell and no retry, so giving up
#   just saves it with its background still on. Never set the batch one below
#   a realistic inference time.
# REMBG_ALPHA_LOW / REMBG_ALPHA_HIGH: the remover's sensitivity (defaults
#   90 / 170). Pixels the model scores below LOW are dropped, above HIGH are
#   kept solid, and the band between is ramped into the edge. RAISE LOW toward
#   ~120 if leftover background ghosting appears; LOWER it toward ~60 if the
#   cutout eats parts of the item — though the border-solidify pass below now
#   rebuilds most edges the thresholds used to shave, so try BG_SOLIDIFY first.
REMBG_MODEL=isnet-general-use
REMBG_MAX_SIDE=640
# REMBG_ALPHA_LOW=90
# REMBG_ALPHA_HIGH=170

# Interior-hole repair (applies to EVERY engine, not just rembg). A matte that
# calls a printed graphic or a bright panel INSIDE the item "background" punches
# a white hole through the middle of the product; anything sealed in by subject
# that doesn't look like the backdrop we removed gets put back.
# BG_HOLE_TOLERANCE: how far (RGB distance) an enclosed region must sit from the
#   removed backdrop before it counts as item. Lower = repairs more but risks
#   filling real see-through gaps (mug handles); raise if gaps get filled in.
# BG_FILL_HOLES=off disables the repair entirely.
# BG_HOLE_TOLERANCE=45
# BG_FILL_HOLES=on

# Border solidification (local engine): the raw matte's boundary is closed
# into one continuous silhouette, floating crumbs are dropped, and the outline
# is snapped onto the item's real edge using the photo itself — this is what
# stops "chewed" cutouts on denim hems and low-contrast edges.
# BG_SOLIDIFY=off falls back to the old plain 1px erode.
# BG_SOLIDIFY_SCAN_SIDE: resolution the border decisions run at (default 768).
# BG_SOLIDIFY=on
# BG_SOLIDIFY_SCAN_SIDE=768

# How many photos run through the pipeline at once when the LOCAL engine (or
# no cutout) does the work. Model inference is always single-flight; this only
# overlaps the mask/crop/encode work around it. 1 = strictly serial.
# Size it to CORES, not to RAM: a worker with no core to run on does not
# overlap anything, it just adds contention to the ones doing the work.
# PHOTO_LOCAL_WORKERS=2

# Content-aware auto-straightening (a small batched vision call before photos
# are optimized; catches the "shirt lying sideways" photo EXIF can't).
# AUTO_ORIENT=off disables the pass entirely; ORIENT_VERIFY=off skips the
# confirmation round-trip and applies the (conservative) first-pass proposals
# directly — one less serial API wait when rotations are proposed.
# AUTO_ORIENT=on
# ORIENT_VERIFY=on

# ---------------------------------------------------------------------------
# eBay API (optional). Leave blank to run in "dry-run" mode, where the app
# builds the exact API payloads and saves them to data/exports/ instead of
# calling eBay. Fill these in when you have a developer account to go live.
#
# Create an app + get tokens at https://developer.ebay.com/
# The Inventory API needs a USER access token (OAuth2, scope:
#   https://api.ebay.com/oauth/api_scope/sell.inventory )
# ---------------------------------------------------------------------------

# "sandbox" or "production"
EBAY_ENV=sandbox

# Bi-directional sync: how many listing-detail calls run at once when importing
# the seller's existing store (see README). Optional.
# EBAY_SYNC_WORKERS=6

# How many existing records a sync reads before deciding what's new — the
# duplicate check's field of view, not a store-size limit. It has to stay wider
# than the store (one item can hold an active row, an ended mirror and a sold
# record at once); a record the read misses is one the dedupe can't match.
# Optional.
# EBAY_SYNC_KNOWN_LIMIT=10000

# How long a passing eBay policy/location check is trusted before the next
# publish re-verifies the saved ids against the connected account, in seconds.
# Lower catches a change made on eBay sooner; higher spends fewer Account API
# calls. Unparseable values fall back to 600 with a warning rather than
# stopping the app from booting. Optional.
# EBAY_POLICY_VERIFY_TTL=600

# How many listings one bulk price drop touches (Dashboard → Suggested actions →
# Lower prices). Each is a serial eBay revise, so this keeps the request inside
# the gateway's patience; the rest are reported for a second run. Optional.
# BULK_PRICE_CAP=40

# A user OAuth access token (or paste a long-lived one for testing).
EBAY_OAUTH_TOKEN=

# Recommended: "Sign in with eBay" OAuth. Set these three and users can click
# "Connect eBay" in the app - no manual token/policy pasting. CLIENT_ID/SECRET
# come from your eBay app keyset; RUNAME is the redirect URL name whose accepted
# URL points at https://<your-domain>/api/ebay/callback
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=

# Fallback only (if not using the connect flow): a static refresh token.
EBAY_REFRESH_TOKEN=

# eBay shipping labels (Sell Logistics API). This is a LIMITED-RELEASE eBay
# API: eBay must approve it for your application keyset before its scope can
# even be requested. Once approved, set this to 1 and the connect flow starts
# asking for sell.logistics (already-connected sellers reconnect once); the
# in-app shipping dialog then offers "Buy label on eBay" alongside the
# Pirate Ship CSV workflow, which needs no setup at all.
EBAY_LOGISTICS_ENABLED=

# Marketplace Account Deletion notifications - REQUIRED for Production keysets.
# Invent a token (32-80 chars: letters/digits/_/-, e.g. `openssl rand -hex 32`)
# and paste the SAME value here and on developer.ebay.com -> Application Keys ->
# Alerts & Notifications, with the endpoint URL:
#   https://<your-domain>/api/ebay/account-deletion
EBAY_VERIFICATION_TOKEN=
# Only needed if a proxy rewrites your scheme/host: the exact endpoint URL as
# registered with eBay (used in the challenge hash). Blank = derived from the
# request.
EBAY_DELETION_ENDPOINT=

# Required by eBay offers: your business policy IDs and merchant location.
# Find/create these in Seller Hub or via the Account API.
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD

# ---------------------------------------------------------------------------
# Etsy (optional). Set both and an "Etsy" card appears under Settings ->
# Cross-posting marketplaces; sellers click Connect Etsy and can then include
# Etsy in any publish. Leave blank and Etsy stays hidden.
#
# Register an app at https://www.etsy.com/developers/register — the app's
# "keystring" is the client id (Etsy v3 uses PKCE; there is no secret to
# store). Personal access works immediately for YOUR shop; ask Etsy for
# Commercial Access before other sellers can connect theirs. The redirect URI
# must be registered on the app EXACTLY as set here:
#   https://<your-domain>/api/etsy/callback
# ---------------------------------------------------------------------------
ETSY_CLIENT_ID=
ETSY_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Depop (optional). Depop's Selling API is PARTNER-GATED: apply through
# Depop's partnerships team (partnerapi.depop.com) to get credentials. The
# OAuth endpoints are env vars because they arrive with partner onboarding —
# fill in all five and the Depop card + publish chip light up. Until then
# Depop shows as "not configured" and never blocks anything.
# ---------------------------------------------------------------------------
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
DEPOP_AUTH_URL=
DEPOP_TOKEN_URL=
# Register with Depop as: https://<your-domain>/api/depop/callback
DEPOP_REDIRECT_URI=
# Optional overrides (defaults are right once partner access is granted):
# DEPOP_API_BASE=https://partnerapi.depop.com
# DEPOP_SCOPES=products_read products_write
